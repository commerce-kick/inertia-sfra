{
  "name": "cnx-root",
  "type": "module",
  "scripts": {
    "dev": "vite --host && rm -rf ./store_front/cartridges/store_front/cartridge/scripts/hot.json",
    "build": "tsc --noEmit --skipLibCheck && vite build",
    "preview": "vite preview",
    "deploy": "npx b2c-tools code deploy",
    "build:ssr": "tsc --noEmit  --skipLibCheck && bun run scripts/generate-routes.js && vite build --ssr --config ssr.config.js",
    "type-check": "tsc --noEmit  --skipLibCheck",
    "build:force": "vite build",
    "test": "bun test test/unit"
  },
  "private": true,
