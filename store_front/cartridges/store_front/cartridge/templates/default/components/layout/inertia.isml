<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="${pdict.csrf.token}">

    <isif condition="${pdict.meta}">
        <isloop items="${pdict.meta}" var="metaTag">
            <isprint value="${metaTag}" encoding="off" />
        </isloop>
    </isif>

    <isinclude url="${URLUtils.url('Inertia-Head', 'component', pdict.page.component)}" />
</head>

<body>
    <iscomment>
        The @inertiajs v3.6 client boots from this JSON script tag
        (script[data-page="app"][type="application/json"]) and mounts into the
        empty #app div. pageJson is pre-escaped by the adapter (angle brackets are JSON-escaped so a prop value can never break out of this script tag).
    </iscomment>
    <script data-page="app" type="application/json"><isprint value="${pdict.pageJson}" encoding="off"/></script>
    <div id="app"></div>
</body>

</html>
